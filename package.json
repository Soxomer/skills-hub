{
  "name": "skills-hub",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:web": "npm run dev --workspace @ahm/web",
    "build": "npm run build:desktop && npm run build:contracts && npm run build:control-plane && npm run build:web && npm run build:domain && npm run build:runner",
    "build:desktop": "tsc -b && vite build",
    "build:contracts": "npm run build --workspace @ahm/contracts",
    "build:control-plane": "npm run build --workspace @ahm/control-plane",
    "build:web": "npm run build --workspace @ahm/web",
    "build:domain": "cargo build --manifest-path Cargo.toml -p ahm-domain",
    "build:runner": "cargo build --manifest-path Cargo.toml -p ahm-runner",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contracts": "npm run test --workspace @ahm/contracts",
    "test:control-plane": "npm run test --workspace @ahm/control-plane",
    "boundary:check": "node scripts/check-workspace-boundaries.mjs",
    "cli": "cargo run --manifest-path Cargo.toml -p ahm-runner --bin ahm --",
    "cli:build": "cargo build --manifest-path Cargo.toml -p ahm-runner --bin ahm",
    "runner": "cargo run --manifest-path Cargo.toml -p ahm-runner --bin ahm -- worker",
    "rust:fmt": "cargo fmt --manifest-path Cargo.toml --all",
    "rust:fmt:check": "cargo fmt --manifest-path Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path Cargo.toml --workspace",
    "check": "npm run boundary:check && npm run lint && npm run test && npm run build && npm run rust:fmt:check && npm run rust:clippy && npm run rust:test",
    "preview": "vite preview",
    "version:set": "node scripts/version.mjs set",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:icon:desktop": "node scripts/tauri-icon-desktop.mjs",
    "tauri:build": "npm run version:check && tauri build",
    "tauri:build:mac:dmg": "npm run tauri:build -- --bundles dmg",
    "tauri:build:mac:universal:dmg": "npm run tauri:build -- --target universal-apple-darwin --bundles dmg",
    "tauri:build:win:exe": "npm run tauri:build -- --bundles nsis",
    "tauri:build:win:msi": "npm run tauri:build -- --bundles msi",
    "tauri:build:win:all": "npm run tauri:build -- --bundles msi,nsis",
    "tauri:build:linux:deb": "npm run tauri:build -- --bundles deb",
    "tauri:build:linux:appimage": "npm run tauri:build -- --bundles appimage",
    "tauri:build:linux:all": "npm run tauri:build -- --bundles deb,appimage"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.91.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.5.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.5.3",
    "clsx": "^2.1.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.9.6",
    "@types/node": "^24.10.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
