{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Hub Helper",
  "version": "0.9.1",
  "identifier": "dev.omarjetti.skills-hub-helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Skills Hub helper", "width": 480, "height": 590, "minWidth": 360, "minHeight": 480, "visible": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ahm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Connect your computer to Skills Hub",
    "category": "DeveloperTool",
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" } },
    "macOS": { "minimumSystemVersion": "10.15" }
  },
  "plugins": { "deep-link": { "desktop": { "schemes": ["ahm"] } } }
}
